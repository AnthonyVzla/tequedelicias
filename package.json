{
  "name": "tequeneria-delicias",
  "version": "1.0.0",
  "description": "Juego, puntos y premios de Tequeñería Delicias.",
  "main": "app.js",
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});['index.html','styles.css','app.js','sw.js','manifest.webmanifest','brand-logo.jpg'].forEach(f=>fs.copyFileSync(f,'www/'+f));\" && cap sync android",
    "android:open": "cap open android",
    "android:build-debug": "cd android && gradlew.bat assembleDebug",
    "android:build-release": "cd android && gradlew.bat assembleRelease"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/local-notifications": "^7.0.0"
  }
}
